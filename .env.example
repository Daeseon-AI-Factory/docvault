# Example environment for local/dev. These are PLACEHOLDERS — generate real values.
# Easiest:  bash scripts/gen-env.sh localhost   (writes a real .env with strong secrets)
# Manual:   openssl rand -hex 32  (master key, jwt) / openssl rand -hex 24 (psk, db password)
#
# Never commit a real .env (it is git-ignored).

DOCVAULT_DB_URL=postgres://docvault_app:REPLACE_DB_PASSWORD@localhost:5432/docvault?sslmode=disable
DOCVAULT_MASTER_KEY=REPLACE_WITH_openssl_rand_hex_32
DOCVAULT_VAULT_PATH=/opt/docvault/vault
DOCVAULT_JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
DOCVAULT_LISTEN_ADDR=:8080
DOCVAULT_OSQUERY_PSK=REPLACE_WITH_openssl_rand_hex_24
DOCVAULT_SLACK_WEBHOOK=
DOCVAULT_ALERT_EMAIL=
