# DocVault production .env — copy to ".env" and fill in.
# EASIEST: run `bash scripts/gen-env.sh` instead — it generates strong secrets for you.
#
# ---------------------------------------------------------------------------
# Scenario A — dedicated server with a public domain (recommended for remote):
#     DOCVAULT_DOMAIN=docvault.example.com
#   Caddy gets a real Let's Encrypt certificate automatically. The friend's PC
#   runs only the agent, pointing at https://docvault.example.com
#
# Scenario B — all-in-one on a single PC (e.g. friend's Windows + Docker Desktop):
#     DOCVAULT_DOMAIN=localhost
#   Caddy issues a local self-signed cert. The agent runs on the same PC,
#   pointing at https://localhost
# ---------------------------------------------------------------------------

DOCVAULT_DOMAIN=

# Secrets — DO NOT reuse the examples below; generate real ones:
#   openssl rand -hex 32   (master key: must be exactly 32 bytes hex)
#   openssl rand -hex 32   (jwt secret)
#   openssl rand -hex 24   (psk, db password)
DOCVAULT_DB_PASSWORD=
DOCVAULT_MASTER_KEY=
DOCVAULT_JWT_SECRET=
DOCVAULT_OSQUERY_PSK=

# Admin password set on first `seed`. Leave blank to have one generated and
# printed once to the seed container logs.
DOCVAULT_ADMIN_PASSWORD=

# Optional integrations
DOCVAULT_SLACK_WEBHOOK=
DOCVAULT_ALERT_EMAIL=

# ---------------------------------------------------------------------------
# Using an EXTERNAL postgres (not the bundled db service)? Then DocVault should
# connect over TLS. Override the DB URL in docker-compose.prod.yml's x-app-env
# to: postgres://USER:PASS@HOST:5432/docvault?sslmode=require
# ---------------------------------------------------------------------------
