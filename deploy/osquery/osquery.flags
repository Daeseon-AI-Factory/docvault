--tls_hostname=docvault.company.local
--tls_server_certs=C:\ProgramData\osquery\certs\docvault-ca.pem
--enroll_secret_path=C:\ProgramData\osquery\enroll_secret
--config_plugin=tls
--config_tls_endpoint=/api/config
--logger_plugin=tls
--logger_tls_endpoint=/api/events/osquery
--logger_tls_period=60
--host_identifier=hostname
--enable_file_events=true
--disable_events=false
--events_expiry=86400
--database_path=C:\ProgramData\osquery\osquery.db
--pidfile=C:\ProgramData\osquery\osquery.pid
--extensions_socket=\\.\pipe\osquery.em
